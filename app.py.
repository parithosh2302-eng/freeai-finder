def recommend_tools(text, selected_category):
    query = text.lower().strip()

    keywords = {
        "study": ["study", "homework", "learn", "explain", "school", "notes"],
        "questions": ["question", "answer", "ask", "help"],
        "writing": ["write", "essay", "story", "grammar", "content", "email"],
        "coding": ["code", "coding", "program", "debug", "python", "website"],
        "research": ["research", "sources", "citations", "facts", "latest", "news"],
        "design": ["design", "poster", "graphic", "logo", "artwork"],
        "presentations": ["presentation", "slides", "ppt"],
        "images": ["image", "picture", "visual", "graphics"],
        "documents": ["document", "pdf", "long text", "summarize"],
        "building ai": ["build an ai", "ai app", "chatbot", "api", "developer"]
    }

    matched_intents = []
    for intent, words in keywords.items():
        if any(word in query for word in words):
            matched_intents.append(intent)

    results = []

    for tool in TOOLS:
        if selected_category != "All categories":
            if tool["category"] != selected_category:
                continue

        score = 0

        if not query:
            score = 1
        else:
            for intent in matched_intents:
                if intent in tool["best_for"]:
                    score += 3

            combined = (
                tool["name"] + " " +
                tool["category"] + " " +
                tool["description"] + " " +
                tool["tags"]
            ).lower()

            for word in query.split():
                if len(word) > 3 and word in combined:
                    score += 1

        if score > 0:
            results.append((score, tool))

    results.sort(key=lambda item: item[0], reverse=True)
    return [tool for score, tool in results]

